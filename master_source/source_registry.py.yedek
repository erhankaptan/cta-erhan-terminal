# ============================================================
# TÜM KAYNAKLAR (birleşik görünüm)
# ============================================================

ALL_SOURCES: Dict[str, Dict] = {
    **X_SOURCES,
    **RSS_SOURCES,
    "cftc_cot": COT_SOURCE,
}


# ============================================================
# YARDIMCI FONKSİYONLAR
# ============================================================

def get_source(source_id: str) -> Optional[Dict]:
    """Kaynak ID'den tanım döner."""
    return ALL_SOURCES.get(source_id)


def get_all_source_ids() -> List[str]:
    """Tüm kaynak ID'lerini döner."""
    return list(ALL_SOURCES.keys())


def get_x_sources() -> Dict[str, Dict]:
    """Tüm X kaynaklarını döner."""
    return X_SOURCES


def get_rss_sources() -> Dict[str, Dict]:
    """Tüm RSS kaynaklarını döner."""
    return RSS_SOURCES


def get_priority_sources() -> Dict[str, Dict]:
    """Öncelikli kaynakları döner (analyze_enabled=True)."""
    return {k: v for k, v in ALL_SOURCES.items() if v.get("analyze_enabled")}


def get_sources_by_type(source_type: str) -> Dict[str, Dict]:
    """Kaynak tipine göre filtrele (X / COT / RSS)."""
    return {k: v for k, v in ALL_SOURCES.items() if v.get("source_type") == source_type}


def get_sources_by_category(category: str) -> Dict[str, Dict]:
    """Kategoriye göre filtrele (CTA Uzmanı, Haber, vs.)."""
    return {k: v for k, v in X_SOURCES.items() if v.get("category") == category}


# ============================================================
# KONTROL
# ============================================================

if __name__ == "__main__":
    x_total = len(X_SOURCES)
    x_priority = len([s for s in X_SOURCES.values() if s["analyze_enabled"]])
    rss_total = len(RSS_SOURCES)
    cot_total = 1

    print(f"X hesapları toplam: {x_total}")
    print(f"X hesapları analiz edilen: {x_priority}")
    print(f"RSS kaynakları: {rss_total}")
    print(f"COT kaynakları: {cot_total}")
    print(f"TOPLAM kaynak: {len(ALL_SOURCES)}")
    print()

    if x_priority != 10:
        print(f"UYARI: 10 öncelikli beklenıyordu, {x_priority} bulundu")
    else:
        print("OK: 10 öncelikli X hesabı")

    # Kategori dağılımı
    from collections import Counter
    categories = Counter(s["category"] for s in X_SOURCES.values())
    print("\nX kategorileri:")
    for cat, count in sorted(categories.items()):
        print(f"  {cat}: {count}")