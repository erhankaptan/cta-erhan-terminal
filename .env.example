# CTA ERHAN Docker -- ortam degiskenleri
# Bu dosyayi ".env" olarak kopyala ve kendi degerlerine gore duzenle.
# Native'deki GERCEK .env dosyandaki GEMINI_API_KEY'i AYNEN buraya tasi --
# asagidaki satir sadece SABLON, gercek deger DEGIL.

GEMINI_API_KEY=

# CTA Terminali'nin (ayri terminal, henuz Docker'a gecmedi) cikti
# klasorunun HOST'taki yolu -- icinde cme_cot_raw_export.json var.
# Native'de bu C:\cta_terminal idi.
CTA_ERHAN_MERKEZ_COT_HOST_DIR=C:\cta_terminal
