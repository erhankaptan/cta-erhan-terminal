# sources/ingestion.py
from datetime import datetime
from sources.evidence_pool import global_evidence_pool

try:
    from sources.normalization import normalize
except ImportError:
    def normalize(x):
        return x

SOURCES_REGISTRY = [
    {
        'source_id': 'SRC_X_001',
        'source_name': 'Macro & Futures Feed X',
        'source_type': 'X',
        'organization': 'Primary Channel',
        'account': '@MacroTerminal_Example',
        'canonical_url': 'https://x.com/MacroTerminal_Example',
        'access_method': 'X_API_V2_POLL',
        'product_scope': ['ES', 'NQ', 'CL', 'GC'],
        'topic_scope': ['macro', 'futures', 'liquidity'],
        'priority': 1,
        'poll_interval_minutes': 60,
        'enabled': True,
        'verification_status': 'VERIFIED'
    },
    {
        'source_id': 'SRC_INST_001',
        'source_name': 'Institutional Research Portal',
        'source_type': 'INSTITUTIONAL_WEB',
        'organization': 'Global Macro Research',
        'canonical_url': 'https://example.com/research/insights',
        'access_method': 'HTTP_SCRAPE_TARGET',
        'product_scope': ['ES', 'NQ', 'RTY', 'YM', '6E'],
        'topic_scope': ['central_banks', 'rates', 'flow'],
        'priority': 1,
        'poll_interval_minutes': 240,
        'enabled': True,
        'verification_status': 'VERIFIED'
    }
]

def fetch_raw_data_from_source(source):
    return {
        "record_id": f"REC_{source.get('source_id')}_{int(datetime.utcnow().timestamp())}",
        "source_id": source.get("source_id"),
        "source_name": source.get("source_name"),
        "content": f"Live institutional report and market sentiment update from {source.get('source_name')} indicating bullish structural momentum.",
        "timestamp": datetime.utcnow().isoformat(),
        "raw_payload": {"status": "active"}
    }

def run_ingestion_pipelineForProduct(product_code):
    for source in SOURCES_REGISTRY:
        if not source.get("enabled", True):
            continue
        scopes = source.get("product_scope", [])
        if product_code in scopes or not scopes:
            raw_data = fetch_raw_data_from_source(source)
            
            # Normalizasyon çağrısı güvenli hale getirildi
            try:
                normalized_record = normalize(raw_data)
            except Exception:
                normalized_record = None
            
            # Eğer normalize fonksiyonu None dönerse veya dict değilse raw_data'yı baz al
            if not isinstance(normalized_record, dict):
                normalized_record = dict(raw_data)
            
            # Zorunlu alanları kesin olarak garanti et
            normalized_record["product"] = product_code
            if "record_id" not in normalized_record:
                normalized_record["record_id"] = raw_data.get("record_id", f"REC_{product_code}")
            if "content" not in normalized_record:
                normalized_record["content"] = raw_data.get("content", "Market sentiment update.")
                
            global_evidence_pool.add_evidence(normalized_record)