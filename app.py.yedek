# ============================================================
# ÜRÜNLER
# ============================================================
products = [
    "ES", "MES", "NQ", "MNQ", "RTY", "YM",
    "CL", "MCL", "NG",
    "GC", "MGC", "SI", "HG", "PL",
    "6E", "6J", "6B", "6A", "6C", "6S",
    "ZC", "ZS", "ZW", "ZL", "ZM"
]
product_names = {
    "ES": "S&P 500 E-mini",
    "MES": "Micro S&P 500",
    "NQ": "Nasdaq 100 E-mini",
    "MNQ": "Micro Nasdaq 100",
    "RTY": "Russell 2000 E-mini",
    "YM": "Dow E-mini",
    "CL": "Ham Petrol",
    "MCL": "Micro Ham Petrol",
    "NG": "Doğal Gaz",
    "GC": "Altın",
    "MGC": "Micro Altın",
    "SI": "Gümüş",
    "HG": "Bakır",
    "PL": "Platin",
    "6E": "Euro FX",
    "6J": "Japon Yeni",
    "6B": "İngiliz Sterlini",
    "6A": "Avustralya Doları",
    "6C": "Kanada Doları",
    "6S": "İsviçre Frangı",
    "ZC": "Mısır",
    "ZS": "Soya Fasulyesi",
    "ZW": "Buğday",
    "ZL": "Soya Yağı",
    "ZM": "Soya Küspesi",
}

# ============================================================
# SOL MENÜ
# ============================================================
with st.sidebar:
    st.markdown(
        '<h1 style="color:#00E5FF;">◉ CTA ERHAN</h1>',
        unsafe_allow_html=True,
    )
    st.caption("Vadeli İşlemler / CTA / Piyasa İstihbaratı")
    st.divider()
    st.subheader("ÜRÜN SEÇİMİ")
    selected_product = st.selectbox(
        "Aktif ürün",
        products,
        index=0,
    )
    st.markdown(
        f'<h2 style="color:#00E5FF;">{selected_product}</h2>',
        unsafe_allow_html=True,
    )
    st.caption(product_names[selected_product])
    st.divider()
    st.subheader("TERMİNAL")
    st.write("◉ CTA Radarı")
    st.write("◉ Vadeli İşlemler Panosu")
    st.write("◉ COT Analizi")
    st.write("◉ Kaynak İstihbaratı")
    st.write("◉ Kanıt Havuzu")
    st.write("◉ Analiz")
    st.write("◉ Sentez")
    st.divider()
    st.subheader("SİSTEM SINIRI")
    st.success("SALT OKUNUR İSTİHBARAT")
    st.write("Karar üretmez.")
    st.write("Emir göndermez.")
    st.write("Otomatik işlem yapmaz.")

# ============================================================
# BACKEND BAĞLANTISI
# ============================================================
analysis = run_analysis_for_product(selected_product)

cta_yon = analysis.get("synthesis_state", "NÖTR")
if cta_yon == "INSUFFICIENT":
    cta_yon = "NÖTR"
elif cta_yon == "BULLISH":
    cta_yon = "YÜKSELİŞ"
elif cta_yon == "BEARISH":
    cta_yon = "DÜŞÜŞ"

guven = analysis.get("confidence", "—")
kanit_sayisi = analysis.get("evidence_count", 0)

yon = "YETERSİZ" if kanit_sayisi == 0 else cta_yon
guc = "YETERSİZ" if kanit_sayisi == 0 else analysis.get("strength", "YETERSİZ")
belirsizlik = "YÜKSEK" if kanit_sayisi == 0 else analysis.get("uncertainty", "YÜKSEK")
catisma = analysis.get("conflict", "YOK")
rejim = analysis.get("regime", "BİLİNMİYOR")
nihai_yon = yon

# ============================================================
# ANA BAŞLIK
# ============================================================
st.markdown(
    '<h1 style="color:#00E5FF;">◉ CTA ERHAN TERMİNALİ</h1>',
    unsafe_allow_html=True,
)
st.caption("Vadeli İşlemler / CTA / Piyasa İstihbaratı")

st.markdown(
    f"""
    <div class="aktif-urun-kutu">
        <span class="aktif-urun-baslik">AKTİF ÜRÜN: </span>
        <span class="aktif-urun-deger">{selected_product} — {product_names[selected_product]}</span>
    </div>
    """,
    unsafe_allow_html=True,
)
st.divider()

# ============================================================
# SİSTEM DURUMU
# ============================================================
st.subheader("SİSTEM DURUMU")
col1, col2, col3, col4, col5 = st.columns(5)
with col1:
    st.metric("CTA YÖNÜ", cta_yon)
with col2:
    st.metric("GÜVEN", guven)
with col3:
    st.metric("REJİM", rejim)
with col4:
    st.metric("KAYNAK DURUMU", "HAZIR")
with col5:
    st.metric("KANIT", kanit_sayisi)
st.divider()

# ============================================================
# ANA PANELLER (4 SÜTUN)
# ============================================================
c1, c2, c3, c4 = st.columns(4)

# ============================================================
# SÜTUN 1: CTA RADARI + VADELİ İŞLEMLER PANOSU
# ============================================================
with c1:
    st.header("CTA RADARI")
    st.write(f"Ürün: {selected_product}")
    st.write(f"Yön: {yon}")
    st.write(f"Güç: {guc}")
    st.write(f"Belirsizlik: {belirsizlik}")
    st.write(f"Çatışma: {catisma}")
    st.write(f"Nihai Yön: {nihai_yon}")
    st.divider()
    st.header("VADELİ İŞLEMLER PANOSU")
    st.write(f"Kontrat: **{selected_product}**")
    st.write(f"Enstrüman: **{product_names[selected_product]}**")
    st.write("Fiyat: —")
    st.write("Hacim: —")
    st.write("Açık Pozisyon: —")
    st.write("Volatilite: —")
    st.info("Gerçek piyasa verisi bu aşamada bağlı değil.")
    with st.expander("Detaylar"):
        st.write("Veri kaynağı: —")
        st.write("Zaman damgası: —")
        st.write("Seans: —")

# ============================================================
# SÜTUN 2: KAYNAK İSTİHBARATI + KANIT HAVUZU
# ============================================================
with c2:
    st.header("KAYNAK İSTİHBARATI")
    tab1, tab2, tab3, tab4 = st.tabs([
        "X / BİRİNCİL",
        "RSS / HABER",
        "KURUMSAL",
        "PDF RAPORLAR",
    ])
    with tab1:
        st.subheader("X / Birincil Kaynak")
        st.info("X gönderileri birincil kaynak katmanıdır.")
        st.metric("Gönderiler", kanit_sayisi)
        st.write("Doğrulanmış: 0")
        st.write("Doğrulanmamış: 0")
        with st.expander("Detaylar"):
            st.write("Kaynak alma: HAZIR")
            st.write("Ayrıştırma: HAZIR")
            st.write("Kanıt çıkarımı: HAZIR")
    with tab2:
        st.subheader("RSS / Haber")
        st.info("RSS haber ve araştırma akışları.")
        st.write("Akışlar: 0")
        st.write("Öğeler: 0")
        st.write("Güncel: 0")
    with tab3:
        st.subheader("Kurumsal Kaynaklar")
        st.info("Kurumların açık web ve araştırma yayınları.")
        st.write("Kurumlar: 0")
        st.write("Belgeler: 0")
        st.write("Doğrulanmış: 0")
    with tab4:
        st.subheader("PDF Raporları")
        st.info("Kurumsal PDF raporları.")
        st.write("PDF dosyaları: 0")
        st.write("Taranan sayfalar: 0")
        st.write("Çıkarılan kanıt: 0")
    st.divider()
    st.header("KANIT HAVUZU")
    evidence = {
        "Kaynak": ["—"],
        "Tür": ["—"],
        "Ürün": [selected_product],
        "Durum": ["KANIT YOK" if kanit_sayisi == 0 else "KANIT VAR"],
        "Zaman": ["—"],
    }
    with st.expander("Kanıt Tablosu"):
        st.dataframe(
            evidence,
            use_container_width=True,
            hide_index=True,
        )
    st.caption("Kaynak → Kaynak Geçmişi → Kanıt → İstihbarat")

# ============================================================
# SÜTUN 3: ANALİZ + SENTEZ
# ============================================================
with c3:
    st.header("ANALİZ")
    st.write("Yön")
    st.warning(yon)
    st.write("Güç")
    st.warning(guc)
    st.write("Belirsizlik")
    st.warning(belirsizlik)
    st.write("Çatışma")
    st.success(catisma)
    st.write("Rejim")
    st.warning(rejim)
    st.divider()
    st.header("SENTEZ")
    if kanit_sayisi == 0:
        st.markdown(
            '<div style="background:#0F2A5C;border:1px solid #1E4FA8;border-radius:4px;padding:6px 12px;color:#FFFFFF;font-weight:700;font-size:13px;">YETERSİZ KANIT</div>',
            unsafe_allow_html=True,
        )
        st.write("Mevcut kanıtlarla doğrulanmış yönsel sonuç üretilemiyor.")
        st.write(f"Nihai Yön: **{nihai_yon}**")
    else:
        st.markdown(
            f'<div style="background:#0F2A5C;border:1px solid #1E4FA8;border-radius:4px;padding:6px 12px;color:#FFFFFF;font-weight:700;font-size:13px;">{cta_yon}</div>',
            unsafe_allow_html=True,
        )
        st.write(f"Kanıt sayısı: {kanit_sayisi}")
        st.write(f"Nihai Yön: **{nihai_yon}**")
    with st.expander("Detaylar"):
        st.write(f"TÜMÜ UYUMLU: {'Evet' if kanit_sayisi > 0 else 'Hayır'}")
        st.write(f"NÖTR: {'Evet' if cta_yon == 'NÖTR' else 'Hayır'}")
        st.write("BÖLÜNMÜŞ: Hayır")
        st.write(f"YETERSİZ: {'Evet' if kanit_sayisi == 0 else 'Hayır'}")

# ============================================================
# SÜTUN 4: COT ANALİZİ (DİNAMİK)
# ============================================================
with c4:
    st.header("COT ANALİZİ")

    cot = analysis.get("cot", {})
    if cot.get("available"):
        summary = cot.get("summary", {})
        details = cot.get("details", {})

        st.write("CFTC COT: **YALNIZCA VEKİL VERİ**")
        st.write(summary.get("line1", "—"))
        st.write(summary.get("line2", "—"))
        st.write(summary.get("line3", "—"))

        with st.expander("Detaylar"):
            st.write(f"**Piyasa:** {details.get('market', '—')}")
            st.write(f"**Rapor:** {details.get('report_date', '—')}")
            st.write(f"**Açık Pozisyon:** {details.get('open_interest', 0):,}")
            st.write(f"**Squeeze Riski:** {details.get('squeeze_risk', '—')}")
            st.write("---")
            st.write("**Leveraged Funds (CTA Proxy)**")
            cta = details.get("cta_proxy", {})
            st.write(f"Long: {cta.get('long', 0):,} | Short: {cta.get('short', 0):,}")
            st.write(f"Net: {cta.get('net', 0):+,} | Değişim: {cta.get('change_net', 0):+,}")
            st.write("**Dealer (Sell-side)**")
            dealer = details.get("dealer", {})
            st.write(f"Net: {dealer.get('net', 0):+,}")
            st.write("**Asset Manager (Kurumsal)**")
            inst = details.get("institutional", {})
            st.write(f"Net: {inst.get('net', 0):+,}")
            st.caption("COT verisi doğrudan CTA pozisyonu değildir.")
            st.caption("Yalnızca vekil veri ve araştırma kanıtı olarak kullanılır.")
    else:
        st.write("CFTC COT: **YALNIZCA VEKİL VERİ**")
        st.write("Yönetilen Para: —")
        st.write("Ticari Pozisyonlar: —")
        st.write("Ticari Olmayan Pozisyonlar: —")
        with st.expander("Detaylar"):
            st.write("COT verisi doğrudan CTA pozisyonu değildir.")
            st.write("Yalnızca vekil veri ve araştırma kanıtı olarak kullanılır.")

    st.divider()
    st.caption("COT = Commitments of Traders")
    st.caption("CFTC haftalık raporu")

# ============================================================
# ALT SATIR (4 SÜTUN)
# ============================================================
st.divider()
a1, a2, a3, a4 = st.columns(4)

with a1:
    st.header("İSTİHBARAT AKIŞI")
    st.write("1 — KAYNAK")
    st.write("2 — KAYNAK ALMA")
    st.write("3 — NORMALİZASYON")
    st.write("4 — KAYNAK GEÇMİŞİ")
    st.write("5 — KANIT")
    st.write("6 — İSTİHBARAT")
    st.write("7 — SENTEZ")

with a2:
    st.header("DOĞRULAMA")
    st.write("Kaynak doğrulaması: —")
    st.write("Güncellik doğrulaması: —")
    st.write("Kanıt doğrulaması: —")
    st.write("Çatışma doğrulaması: —")
    st.write("Çürütme testi: —")

with a3:
    st.header("OPERASYONEL DURUM")
    st.write("Terminal: HAZIR")
    st.write("Kaynak Motoru: HAZIR")
    st.write("Kanıt Motoru: HAZIR")
    st.write("Analiz Motoru: HAZIR")
    st.write("İşlem: DEVRE DIŞI")

with a4:
    st.header("KAYNAK DURUMU")
    st.write("X / Birincil: **HAZIR**")
    st.write("RSS: **HAZIR**")
    st.write("Kurumsal: **HAZIR**")
    st.write("PDF: **HAZIR**")
    st.write("COT: **HAZIR**")
    st.write("IBKR / TWS: **İSTEĞE BAĞLI**")

st.divider()
st.caption("CTA ERHAN Terminali | Kanıt Öncelikli | Salt Okunur İstihbarat")