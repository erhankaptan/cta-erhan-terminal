import streamlit as st
from sources.analysis_engine import run_analysis_for_product
from sources.evidence_pool import global_evidence_pool

st.set_page_config(
    page_title="CTA ERHAN Terminali",
    page_icon="◉",
    layout="wide",
    initial_sidebar_state="expanded",
)

# ============================================================
# GLOBAL CSS
# ============================================================
st.markdown(
    """
