# ============================================================
# GITHUB OTOMATİK ÇEKME
# ============================================================
GITHUB_RAW = "https://raw.githubusercontent.com/erhankaptan/cta-erhan-terminal/main"
GITHUB_API = "https://api.github.com/repos/erhankaptan/cta-erhan-terminal/contents"

PROJECT_ROOT = Path(__file__).parent.resolve()
DATA_DIR = PROJECT_ROOT / "data"
TWEETS_DIR = DATA_DIR / "tweets"
ANALYSIS_DIR = DATA_DIR / "analysis"

def _ensure_dirs():
    TWEETS_DIR.mkdir(parents=True, exist_ok=True)
    ANALYSIS_DIR.mkdir(parents=True, exist_ok=True)

def _http_get(url, timeout=15):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "CTA-Erhan-Terminal"})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read()
    except Exception:
        return None

def _list_github_dir(subpath):
    try:
        url = f"{GITHUB_API}/{subpath}"
        data = _http_get(url, timeout=15)
        if not data:
            return []
        items = json.loads(data.decode("utf-8"))
        if not isinstance(items, list):
            return []
        return [i for i in items if i.get("type") == "file" and i.get("name", "").endswith(".json")]
    except Exception:
        return []

def _download_latest(subpath, target_dir, max_files=5):
    _ensure_dirs()
    files = _list_github_dir(subpath)
    if not files:
        return 0
    files_sorted = sorted(files, key=lambda x: x.get("name", ""))
    latest = files_sorted[-max_files:]
    downloaded = 0
    for item in latest:
        name = item.get("name")
        if not name:
            continue
        target = target_dir / name
        if target.exists():
            continue
        raw_url = f"{GITHUB_RAW}/{subpath}/{name}"
        content = _http_get(raw_url, timeout=20)
        if content:
            try:
                with open(target, "wb") as f:
                    f.write(content)
                downloaded += 1
            except Exception:
                pass
    return downloaded

def sync_from_github():
    n1 = _download_latest("data/tweets", TWEETS_DIR, max_files=5)
    n2 = _download_latest("data/analysis", ANALYSIS_DIR, max_files=5)
    return n1, n2

def load_all_tweets():
    if not TWEETS_DIR.exists():
        return []
    all_tweets = []
    seen = set()
    for fp in sorted(TWEETS_DIR.glob("tweets_*.json")):
        try:
            with open(fp, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, list):
                for t in data:
                    tid = t.get("id", "")
                    if tid and tid not in seen:
                        seen.add(tid)
                        all_tweets.append(t)
        except Exception:
            continue
    return all_tweets

def load_all_analysis():
    if not ANALYSIS_DIR.exists():
        return []
    all_an = []
    seen = set()
    for fp in sorted(ANALYSIS_DIR.glob("analysis_*.json")):
        try:
            with open(fp, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, list):
                for a in data:
                    tid = a.get("tweet_id", "")
                    if tid and tid not in seen:
                        seen.add(tid)
                        all_an.append(a)
        except Exception:
            continue
    return all_an

